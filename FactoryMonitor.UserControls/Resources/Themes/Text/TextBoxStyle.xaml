    <Style x:Key="DefaultTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
        <Setter Property="Background" Value="{DynamicResource PressedBackground}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="5" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="{DynamicResource BorderForeground}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="5">
                        <Border
                            x:Name="BoxInnerBorder"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource PressedBackground}"
                            BorderBrush="{DynamicResource AppThemeColor}"
                            BorderThickness="0,0,0,3"
                            CornerRadius="5">
                            <TextBox
                                Margin="5"
                                Background="{Binding ElementName=BoxInnerBorder, Path=Background}"
                                BorderThickness="0"
                                FontSize="{Binding RelativeSource={RelativeSource AncestorType=controls:TextBox}, Path=FontSize}"
                                Text="{Binding RelativeSource={RelativeSource AncestorType=controls:TextBox}, Path=Text}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

