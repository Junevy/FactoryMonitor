<Page
    x:Class="FactoryMonitor.Client.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fm="http://junevy.github.com.fmcontrols"
    xmlns:local="clr-namespace:FactoryMonitor.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sn="clr-namespace:SimpleNavigation.Services;assembly=SimpleNavigation"
    xmlns:vm="clr-namespace:FactoryMonitor.Client.ViewModels"
    Title="HomeView"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource SubBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <fm:TabMenu
            Grid.Row="0"
            fm:IconHelper.Margin="5,0,5,0"
            fm:TitleHelper.Size="12"
            fm:TitleHelper.Visibility="Visible"
            CloseCommand="{Binding CloseTabCommand}"
            ItemsSource="{Binding Items}"
            NavigateCommand="{Binding NavigateCommand}" />

        <Border
            Grid.Row="1"
            Background="{DynamicResource SubBackground}"
            BorderBrush="{DynamicResource SubBackground}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadius}">
            <Frame x:Name="MainContentControl" sn:RegionService.RegionName="HomeViewRegion" />
        </Border>

    </Grid>
</Page>
