<Page
    x:Class="FactoryMonitor.Client.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fm="http://junevy.github.com.fmcontrols"
    xmlns:local="clr-namespace:FactoryMonitor.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FactoryMonitor.Client.ViewModels"
    Title="HomePage"
    d:DataContext="{d:DesignInstance Type=vm:HomePageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Left">
        <TextBlock Text="Port Name" />
        <ComboBox
            Width="120"
            ItemsSource="{Binding Serials}"
            SelectedItem="{Binding Config.PortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Baud Rate" />
        <TextBox Width="120" Text="{Binding Config.BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Bits" />
        <TextBox Width="120" Text="{Binding Config.DataBits}" />

        <TextBlock Text="Parity" />
        <TextBox Width="120" Text="{Binding Config.Parity}" />

        <TextBlock Text="Stop Bit" />
        <TextBox
            Width="120"
            FontSize="22"
            Text="{Binding Config.StopBits}" />

        <Button
            Width="120"
            Command="{Binding ConnectCommand}"
            Content="connect" />

        <fm:TextBox
            Width="333"
            Margin="20"
            fm:IconHelper.Icon="&#xe639;"
            fm:IconHelper.Margin="10,10,0,10"
            CloseButton="Visible"
            FontSize="14"
            ShowClear="False"
            Text="123" />

        <fm:Button
            Width="120"
            Height="30"
            fm:IconHelper.Icon="&#xe639;"
            Content="click me" />

        <!--<TextBox
            Width="120"
            Height="20"
            FontSize="44"
            Text="123" />-->


    </StackPanel>
</Page>
